<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B131F">

    <!-- 1. Background Gambar Stadion Sepak Bola -->
    <ImageView
        android:id="@+id/imgStadium"
        android:layout_width="match_parent"
        android:layout_height="335dp"
        android:layout_alignParentTop="true"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_stadium" />

    <!-- Overlay Gradasi Gelap -->
    <View
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:background="#33000000" />

    <!-- 3. Header Curved Background -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="290dp"
        android:layout_alignParentTop="true"
        android:layout_marginTop="26dp"
        android:scaleType="fitXY"
        android:src="@drawable/bg_curved_header" />

    <RelativeLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:paddingTop="128dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgProfile"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:strokeColor="#FFD700"
            app:strokeWidth="2dp" />
    </RelativeLayout>

    <!-- 4. Header Logo -->
    <LinearLayout
        android:id="@+id/logoLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerLayout"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="140dp"
            android:src="@drawable/tebakbola" />
    </LinearLayout>

    <!-- 5. Gambar Bola Emas -->
    <ImageView
        android:id="@+id/imgGoldBall"
        android:layout_width="120dp"
        android:layout_height="150dp"
        android:layout_below="@+id/headerLayout"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="118dp"
        android:elevation="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/img_gold_ball" />

    <!-- 6. Container Menu Utama (Berbasis Ikon) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottomNavContainer"
        android:layout_below="@id/imgGoldBall"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <!-- Menu Kategori -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnCategory"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_margin="8dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#111A28"
            app:cardCornerRadius="16dp"
            app:strokeColor="#7A6538"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_menu_play" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/nav_quiz"
                    android:textColor="#E8D5A3"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Menu Leaderboard -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnLeaderboard"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_margin="8dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#111A28"
            app:cardCornerRadius="16dp"
            app:strokeColor="#7A6538"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_menu_leaderboard" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/nav_ranking"
                    android:textColor="#E8D5A3"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Menu Profil -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnProfile"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_margin="8dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#111A28"
            app:cardCornerRadius="16dp"
            app:strokeColor="#7A6538"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_menu_profile" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/nav_profile"
                    android:textColor="#E8D5A3"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- 7. Banner Ad Container -->
    <LinearLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <!-- AdMob Banner Container -->
        <FrameLayout
            android:id="@+id/adViewContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#050A10" />

    </LinearLayout>

</RelativeLayout>